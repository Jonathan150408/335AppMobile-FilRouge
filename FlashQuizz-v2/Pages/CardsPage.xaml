<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FlashQuizz_v2.Pages.CardsPage"
    Title="Anglais"
    BackgroundColor="#EAF1FF">

    <!-- Add button -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnAddCardClicked"/>

    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="10">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="10">

            <Grid ColumnDefinitions="auto,*,auto">
                <!-- Number of cards-->
                <Label Text="{Binding _Cards.Count, StringFormat='{}{0} cartes'}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#2563EB"
                       Grid.Column="0"/>
                <!-- Edit parent deck button -->
                <Button Text="✏ Modifier"
                        Clicked="OnEditParentDeck"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="45"
                        Grid.Column="2"
                        CommandParameter="{ Binding Deck }"/>
            </Grid>

            <!-- Training button -->
            <Button Text="▷ Commencer l'entraînement"
                    Clicked="OnStartTrainingClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="45"/>

        </VerticalStackLayout>

        <!-- List of cards -->
        <CollectionView Grid.Row="2"
                        Margin="0,15,0,0"
                        x:Name="CardsCollectionView"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <!-- Card -->
                    <Frame Margin="0,0,0,12"
                           Padding="12"
                           CornerRadius="12"
                           BackgroundColor="White"
                           BorderColor="Transparent"
                           HasShadow="False">

                        <VerticalStackLayout Spacing="10">

                            <!-- Question -->
                            <VerticalStackLayout Spacing="2">

                                <Label Text="Question"
                                       FontSize="10"
                                       TextColor="Gray"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Question}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E3A8A"/>
                            </VerticalStackLayout>

                            <!-- Response -->
                            <VerticalStackLayout Spacing="2">

                                <Label Text="Réponse"
                                       FontSize="10"
                                       TextColor="Gray"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Answer}"
                                       FontSize="14"
                                       TextColor="#2563EB"/>
                            </VerticalStackLayout>

                            <!-- Buttons -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <!-- Edit -->
                                <Button Grid.Column="0"
                                        Text="✏ Editer"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="38"
                                        Clicked="OnEditCardClicked"
                                        CommandParameter="{Binding .}"/>

                                <!-- Delete -->
                                <Button Grid.Column="1"
                                        Text="🗑 Supprimer"
                                        BackgroundColor="#EF4444"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="38"
                                        Clicked="OnDeleteCardClicked"
                                        CommandParameter="{Binding .}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty View -->
            <CollectionView.EmptyView>

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10">

                    <Label Text="📚"
                           FontSize="60"
                           HorizontalOptions="Center"/>

                    <Label Text="Aucune carte"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1E3A8A"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</ContentPage>