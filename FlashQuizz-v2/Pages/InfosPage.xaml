<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FlashQuizz_v2.Pages.InfosPage"
    Title="Infos"
    BackgroundColor="#EAF1FF">

    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <!-- Logo -->
            <Frame WidthRequest="90"
                   HeightRequest="90"
                   CornerRadius="45"
                   BackgroundColor="#2563EB"
                   BorderColor="Transparent"
                   HorizontalOptions="Center"
                   HasShadow="False"
                   Padding="0">

                <Label Text="🎓"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="White"/>
            </Frame>

            <!-- App name -->
            <Label Text="Flashcards"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1E3A8A"/>

            <!-- About -->
            <Frame BackgroundColor="White"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="18"
                   HasShadow="False">

                <VerticalStackLayout Spacing="10">

                    <Label Text="About the App"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E3A8A"/>

                    <Label
                        FontSize="14"
                        TextColor="#4B5563"
                        LineBreakMode="WordWrap"
                        x:Name="AppMessage"/>

                </VerticalStackLayout>

            </Frame>

            <!-- Author -->
            <Frame BackgroundColor="White"
                   BorderColor="Transparent"
                   CornerRadius="14"
                   Padding="18"
                   HasShadow="False">

                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout Spacing="8">

                        <Label Text="♡"
                               FontSize="16"
                               TextColor="#2563EB"/>

                        <Label Text="From the Author"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E3A8A"/>

                    </HorizontalStackLayout>

                    <Label
                        FontSize="14"
                        FontAttributes="Italic"
                        TextColor="#4B5563"
                        LineBreakMode="WordWrap"
                        x:Name="AuthorMessage"/>

                    <Label Text="— merci ChatGPT pour le message"
                           FontSize="12"
                           TextColor="#9CA3AF"
                           FontAttributes="Italic"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>