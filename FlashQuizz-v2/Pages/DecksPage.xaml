<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FlashQuizz_v2.Pages.DecksPage"
    Title="Mes Decks"
    BackgroundColor="#EAF1FF">

    <!-- Add button -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+"
                     Priority="0"
                     Order="Primary"
                     Clicked="OnAddDeckClicked"/>
        
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*"
          Padding="15">

        <!-- Search -->
        <SearchBar Grid.Row="0"
                   Placeholder="Rechercher un deck..."
                   TextChanged="OnSearchTextChanged"
                   Margin="0,0,0,15"
                   BackgroundColor="White" />

        <!-- Liste -->
        <CollectionView Grid.Row="1"
                        x:Name="DecksCollectionView"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <!-- Deck -->
                    <Frame Margin="0,0,0,12"
                           Padding="0"
                           CornerRadius="16"
                           HasShadow="False"
                           BorderColor="Transparent"
                           BackgroundColor="White">
                        
                        <Grid ColumnDefinitions="6,*,Auto"
                              Padding="0">

                            <!-- Let the user navigate to the cards page -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeckClicked"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <!-- Left blue banner -->
                            <BoxView Grid.Column="0"
                                     Color="#3B82F6"
                                     CornerRadius="8" />

                            <!-- Infos -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="15,12"
                                                 Spacing="4">

                                <!-- Name -->
                                <Label Text="{Binding Name}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#1E3A8A" />

                                <!-- Number of cards -->
                                <HorizontalStackLayout Spacing="5">

                                    <Label Text="📖"
                                           FontSize="14" />

                                    <Label Text="{Binding CardCount, StringFormat='{}{0} cartes'}"
                                           FontSize="14"
                                           TextColor="#2563EB" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                            <!-- Button to start the training -->
                            <Button Grid.Column="2"
                                    Text="Go"
                                    WidthRequest="58"
                                    HeightRequest="40"
                                    Margin="10"
                                    CornerRadius="12"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    Clicked="OnStartTrainingClicked"
                                    CommandParameter="{Binding .}" />

                        </Grid>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Vue vide -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="10">

                    <Label Text="📚"
                           FontSize="60"
                           HorizontalOptions="Center" />

                    <Label Text="Aucun deck"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1E3A8A" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</ContentPage>