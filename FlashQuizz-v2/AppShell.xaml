<?xml version="1.0" encoding="UTF-8" ?>
<Shell
x:Class="FlashQuizz_v2.AppShell"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:views="clr-namespace:FlashQuizz_v2.Pages">

    <FlyoutItem Title="Specification"
                FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent ContentTemplate="{DataTemplate views:DecksPage}"
                        Title="Decks"/>
        <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" 
                        Title="Profil"/>
        <ShellContent ContentTemplate="{DataTemplate views:InfosPage}"
                        Title="Infos"/>
    </FlyoutItem>

</Shell>
