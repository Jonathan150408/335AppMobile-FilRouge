<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FlashQuizz.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FlashQuizz"
    Title="FlashQuizz">

    <TabBar>
        <ShellContent Title="Decks" 
                      Route="DeckPage"
                      ContentTemplate="{DataTemplate local:DecksPage}" />
        <ShellContent Title="Cards"
                      Route="CardsPage"
                      ContentTemplate="{DataTemplate local:CardsPage}" />
        <ShellContent Title="Infos"
                      Route="InfosPage"
                      ContentTemplate="{DataTemplate local:InfosPage}" />
    </TabBar>
</Shell>