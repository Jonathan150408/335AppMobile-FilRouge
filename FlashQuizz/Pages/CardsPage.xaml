<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashQuizz.CardsPage"
             Title="Mes Decks">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">

        <VerticalStackLayout>
            <!-- Header with add button -->
            <HorizontalStackLayout Grid.Row="0"
                                  Spacing="10"
                                  Margin="0,0,0,10">
                <VerticalStackLayout>
                    <Entry x:Name="NewCardQuestionEntry"
                           Placeholder="Question de la nouvelle carte"
                           HorizontalOptions="FillAndExpand" />

                    <Entry x:Name="NewCardAnswerEntry"
                           Placeholder="Réponse de la nouvelle carte"
                           HorizontalOptions="FillAndExpand" />
                </VerticalStackLayout>

                <Button Text="Ajouter"
                        Clicked="OnAddCardClicked"
                        BackgroundColor="#2196F3"
                        TextColor="White" />
            </HorizontalStackLayout>

            <SearchBar Placeholder="Rechercher une carte..."
               TextChanged="OnSearchTextChanged"
               Margin="0,0,0,10" />

        </VerticalStackLayout>

        <!-- Cards list -->
        <CollectionView Grid.Row="1"
                       x:Name="CardsCollectionView"
                       SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5"
                           Padding="10"
                           BorderColor="LightGray"
                           CornerRadius="8"
                           HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto,Auto">

                            <!-- Card info -->
                            <StackLayout Grid.Column="0"
                                        VerticalOptions="Center">
                                <Button Text="{Binding Question}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        BackgroundColor="Transparent"
                                        TextColor="Black"
                                        Clicked="OnCardClicked"/>
                            </StackLayout>

                            <!-- Edit button -->
                            <Button Grid.Column="1"
                                   Text="✏️"
                                   FontSize="20"
                                   BackgroundColor="Transparent"
                                   Clicked="OnEditCardClicked"
                                   CommandParameter="{Binding .}" />

                            <!-- Delete button -->
                            <Button Grid.Column="2"
                                   Text="🗑️"
                                   FontSize="20"
                                   BackgroundColor="Transparent"
                                   Clicked="OnDeleteCardClicked"
                                   CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty view -->
            <CollectionView.EmptyView>
                <StackLayout HorizontalOptions="Center"
                            VerticalOptions="Center">
                    <Label Text="📚"
                           FontSize="60"
                           HorizontalOptions="Center" />
                    <Label Text="Aucune carte"
                           FontSize="18"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                    <Label Text="Créez votre première carte ci-dessus"
                           FontSize="14"
                           TextColor="LightGray"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Info bar -->
        <Label Grid.Row="2"
               x:Name="InfoLabel"
               Text="Prêt"
               FontSize="12"
               TextColor="Gray"
               HorizontalOptions="Center"
               Margin="0,10,0,0" />
    </Grid>

</ContentPage>